{
  "name": "teambridge-assist",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop meeting assistant: system audio capture, local transcription, live overlay.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder",
    "python:setup": "python -m venv .venv && .venv\\Scripts\\python.exe -m pip install -r services/transcription/worker/requirements.txt",
    "postinstall": "node scripts/make-icons.mjs && electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "pino": "^9.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.teambridge.assist",
    "productName": "TeamBridge Assist",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["out/**/*", "build/*.png"],
    "extraResources": [
      { "from": "services/transcription/worker", "to": "worker", "filter": ["**/*.py", "requirements.txt"] }
    ],
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
