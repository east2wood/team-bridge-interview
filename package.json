{
  "name": "teambridge-interview",
  "version": "0.5.0",
  "private": true,
  "description": "Windows desktop interview assistant: opens Windows Live Captions and answers questions with TeamBridge.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:second": "node scripts/dev-second.mjs",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && npm version minor --no-git-tag-version && electron-builder && npm run publish-release",
    "dist:same": "npm run build && electron-builder && npm run publish-release",
    "publish-release": "node scripts/publish-release.mjs",
    "postinstall": "node scripts/make-icons.mjs && electron-builder install-app-deps"
  },
  "dependencies": {
    "koffi": "^3.3.7",
    "pino": "^9.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.teambridge.interview",
    "productName": "TeamBridge Interview",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/*.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
